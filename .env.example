# Copia aquest fitxer com a .env.local per a desenvolupament.

# Postgres (Neon). Si no es defineix, en local s'usa PGlite a ./.data (no cal instal·lar res).
# A Vercel: Storage → Neon → Connect, i la variable es crea sola.
DATABASE_URL=

# Contrasenya de l'administració (/admin). En local, sense valor, és "lamia".
# A Vercel és OBLIGATÒRIA: sense ella l'admin queda desactivada.
ADMIN_PASSWORD=
